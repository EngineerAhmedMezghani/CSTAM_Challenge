    {
      "parameters": {
        "jsCode": "const MAX_CHARS = 8000; // keeps you inside Groq token limits\n\nconst clean = html => String(html || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')\n  .replace(/\\s+/g, ' ').trim();\n\nconst out = [];\nfor (const item of $input.all()) {\n  const t = item.json;\n  let page_text = '', fetch_error = null;\n\n  try {\n    const html = await this.helpers.httpRequest({\n      method: 'GET', url: t.source_url, timeout: 15000, json: false,\n      headers: { 'User-Agent': 'Mozilla/5.0 (compatible; OlivesoftBot/1.0)' }\n    });\n    page_text = clean(html).slice(0, MAX_CHARS);\n  } catch (e) { fetch_error = e.message; }\n\n  const already_known = {\n    title: t.title, description: (t.description || null)?.slice?.(0, 1500) ?? null,\n    owner: t.owner, contact: t.contact,\n    published_date: t.published_date, deadline: t.deadline, documents: t.documents\n  };\n\n  const system = `You extract structured data from public tender (appel d'offres) pages.\nRules:\n- Use ONLY the provided text. Never invent or guess.\n- If a value is not explicitly present, return null.\n- Keep text fields in their original language.\n- Dates must be ISO format YYYY-MM-DD.\n- \"documents\" must be an array of absolute http(s) URLs.\n- \"description\" must be a factual 2-4 sentence summary of the tender scope.\n- Return a single JSON object containing exactly the requested keys, nothing else.`;\n\n  const user = JSON.stringify({\n    source_url: t.source_url,\n    requested_keys: t.missing_fields,\n    already_known,\n    page_text\n  });\n\n  out.push({ json: {\n    tender: t,\n    page_chars: page_text.length,\n    fetch_error,\n    groq_body: {\n      model: \"openai/gpt-oss-120b\",\n      temperature: 0,\n      max_tokens: 1000,\n      response_format: { type: 'json_object' },\n      messages: [\n        { role: 'system', content: system },\n        { role: 'user', content: user }\n      ]\n    }\n  } });\n}\nreturn out;"
      },
