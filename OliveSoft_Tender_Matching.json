        "jsCode": "const out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const key = Object.keys(item.binary || {})[0];\n  let text = '';\n  if (key) {\n    const buf = await this.helpers.getBinaryDataBuffer(i, key);\n    text = buf.toString('utf8');\n  }\n  if (!text.trim()) continue;\n  out.push({ json: { pageContent: text, metadata: {\n    source_type: item.json.source_type,\n    source_folder: item.json.source_folder,\n    file_name: item.json.name,\n    file_id: item.json.id,\n    mime_type: item.json.mimeType,\n    created_time: item.json.createdTime,\n    size: item.json.size,\n    owner: item.json.owners?.[0]?.emailAddress || null,\n    drive_url: item.json.webViewLink || null\n  } } });\n}\nreturn out;"
