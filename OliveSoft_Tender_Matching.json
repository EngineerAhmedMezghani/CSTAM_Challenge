    {
      "parameters": {
        "jsCode": "const prepared = $('Fetch Page & Build Prompt1').all();\n\nconst isEmpty = v =>\n  v === null || v === undefined ||\n  (typeof v === 'string' && (!v.trim() || /^n\\/?a$/i.test(v.trim()))) ||\n  (Array.isArray(v) && v.length === 0);\nconst isIso = s => typeof s === 'string' && /^\\d{4}-\\d{2}-\\d{2}/.test(s);\n\nreturn $input.all().map((item, i) => {\n  const t = prepared[i].json.tender;\n  let extracted = {}, parsed = false;\n\n  try {\n    extracted = JSON.parse(item.json.choices?.[0]?.message?.content);\n    parsed = true;\n  } catch (e) { /* LLM call failed or returned invalid JSON */ }\n\n  const result = { ...t };\n  const filled = [];\n\n  for (const f of t.missing_fields) {\n    let v = extracted[f];\n    if (isEmpty(v)) continue;\n    if (['published_date', 'deadline'].includes(f) && !isIso(v)) continue;\n    if (f === 'documents') {\n      v = (Array.isArray(v) ? v : [v]).filter(u => /^https?:\\/\\//.test(u));\n      if (!v.length) continue;\n    }\n    if (typeof v === 'string') v = v.trim();\n    result[f] = v;\n    filled.push(f);\n  }\n\n  result.enriched_fields = filled;\n  result.still_missing = t.missing_fields.filter(f => !filled.includes(f));\n  result.enrichment_status = !parsed ? 'failed'\n    : filled.length === 0 ? 'no_data_found'\n    : result.still_missing.length ? 'partial' : 'complete';\n\n  return { json: result };\n});"
      },
