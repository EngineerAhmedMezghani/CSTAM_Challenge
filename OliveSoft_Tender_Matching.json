    {
      "parameters": {
        "jsCode": "// ---- config ----\nconst W_BEST = 0.6, W_AVG = 0.4;      // final = 0.6*best + 0.4*avg(top3)\nconst STRONG = 0.75, MEDIUM = 0.60;   // calibrate on your own data\n\nconst tender = $('Loop Over Tenders').first().json;\nconst { embedding_text, ...tenderData } = tender;\n\n// 1) normalise Qdrant hits (score = cosine similarity returned by Qdrant)\nconst hits = $input.all().map(i => i.json)\n  .filter(j => j.document || j.pageContent)\n  .map(j => {\n    const d = j.document || j;\n    const m = d.metadata || {};\n    return { score: Number(j.score), source_type: m.source_type, file_name: m.file_name,\n             file_id: m.file_id, drive_url: m.drive_url, snippet: (d.pageContent || '').slice(0, 200) };\n  })\n  .filter(h => !Number.isNaN(h.score));\n\n// 2) keep best chunk per source file\nconst byFile = new Map();\nfor (const h of hits) {\n  const k = h.file_id || h.file_name || 'unknown';\n  if (!byFile.has(k) || h.score > byFile.get(k).score) byFile.set(k, h);\n}\nconst matches = [...byFile.values()].sort((a, b) => b.score - a.score);\n\n// 3) aggregate scores\nconst best = matches[0]?.score ?? 0;\nconst top3 = matches.slice(0, 3);\nconst avgTop3 = top3.length ? top3.reduce((s, m) => s + m.score, 0) / top3.length : 0;\nconst bestOf = t => Math.max(0, ...matches.filter(m => m.source_type === t).map(m => m.score));\nconst match_score = W_BEST * best + W_AVG * avgTop3;\n\nreturn [{ json: {\n  ...tenderData,\n  match_score: Math.round(match_score * 1000) / 1000,\n  match_percent: Math.round(match_score * 100),\n  match_label: match_score >= STRONG ? 'strong' : match_score >= MEDIUM ? 'medium' : 'weak',\n  best_score: Math.round(best * 1000) / 1000,\n  avg_top3: Math.round(avgTop3 * 1000) / 1000,\n  best_cv_score: Math.round(bestOf('cv') * 1000) / 1000,\n  best_client_score: Math.round(bestOf('client') * 1000) / 1000,\n  top_matches: matches.slice(0, 5)\n} }];"
      },
