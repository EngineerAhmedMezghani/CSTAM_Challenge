        "jsCode": "// Only semantically useful fields go into the query embedding\n// (URLs, extraction method, page type etc. are noise for similarity)\nreturn items.map(item => {\n  const t = item.json;\n  const embedding_text = [\n    `Tender Title: ${t.title || 'N/A'}`,\n    `Description: ${(t.description || 'N/A').slice(0, 4000)}`,\n    `Owner: ${t.owner || 'N/A'}`\n  ].join('\\n\\n');\n  return { json: { ...t, embedding_text } };\n});"
      },
