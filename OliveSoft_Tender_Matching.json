      "parameters": {
        "jsCode": "const FIELDS = ['description', 'owner', 'contact', 'published_date', 'deadline', 'documents'];\n\nconst isEmpty = v =>\n  v === null || v === undefined ||\n  (typeof v === 'string' && (!v.trim() || /^n\\/?a$/i.test(v.trim()))) ||\n  (Array.isArray(v) && v.length === 0);\n\nreturn $input.all().map(({ json: t }) => {\n  const missing_fields = FIELDS.filter(f => isEmpty(t[f]));\n  return { json: { ...t, missing_fields, needs_enrichment: missing_fields.length > 0 && !!t.source_url } };\n});"
      },
